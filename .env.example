# PostgreSQL bootstrap (used by postgres container)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Shared DB URL (used by services)
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DBNAME

# Auth/Gateway secrets
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12
MASTER_USERNAME=Master
MASTER_PASSWORD=change_me
CSRF_SECRET=

# Service URLs
AUTH_SERVICE_URL=http://auth-service:4001
ORDER_SERVICE_URL=http://order-service:4002
NEXT_PUBLIC_API_URL=http://localhost:8000

# Common runtime
NODE_ENV=development
AUTH_PORT=4001
ORDER_PORT=4002
GATEWAY_PORT=8000
