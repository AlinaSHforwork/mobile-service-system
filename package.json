{
  "name": "microservices-root",
  "version": "1.0.0",
  "scripts": {
    "install-all": "npm install && cd services/auth-service && npm install && cd ../order-service && npm install && cd ../gateway && npm install && cd ../../frontend && npm install",
    "start": "concurrently \"cd services/auth-service && npm start\" \"cd services/order-service && npm start\" \"cd services/gateway && npm start\" \"cd frontend && npm run build && npm start\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "eslint": "^10.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "sync-dotenv": "^2.7.0"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.5",
    "mongoose": "^9.1.5",
    "next": "^16.1.6"
  },
  "lint-staged": {
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "bash -c 'cd frontend && npx eslint --fix'",
      "bash -c 'cd frontend && npx prettier --write'"
    ],
    "services/auth-service/**/*.{js,ts}": [
      "bash -c 'cd services/auth-service && npx eslint --fix'",
      "bash -c 'cd services/auth-service && npx prettier --write'"
    ],
    "services/gateway/**/*.{js,ts}": [
      "bash -c 'cd services/gateway && npx eslint --fix'",
      "bash -c 'cd services/gateway && npx prettier --write'"
    ],
    "services/order-service/**/*.{js,ts}": [
      "bash -c 'cd services/order-service && npx eslint --fix'",
      "bash -c 'cd services/order-service && npx prettier --write'"
    ],
    "*.{json,md}": [
      "npx prettier --write --ignore-unknown"
    ]
  }
}
